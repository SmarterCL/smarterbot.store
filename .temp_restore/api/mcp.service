[Unit]
Description=SmarterOS MCP Server
After=network.target

[Service]
User=root
WorkingDirectory=/root/api
# Usamos el python del venv de forma determinística
ExecStart=/root/api/.venv/bin/python mcp_server.py
Restart=always
RestartSec=3

# Logging nativo vía journald (mejor para rotación y journalctl)
StandardOutput=journal
StandardError=journal

# Hardening de Producción
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=4096
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
