{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/producto/layout,_N_T_/producto/page,_N_T_/producto"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/producto/__PAGE__",
    "/producto",
    "/_index",
    "/_head"
  ]
}